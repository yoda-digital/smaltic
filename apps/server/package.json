{
  "name": "@smaltic/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && mkdir -p dist/db/migrations && cp src/db/migrations/*.sql dist/db/migrations/",
    "dev": "tsx watch --conditions=development src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "cli": "tsx --conditions=development src/cli.ts"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.4",
    "@node-rs/argon2": "^2.2.2",
    "@smaltic/model": "workspace:*",
    "fastify": "^5.0.0",
    "postgres": "^3.4.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@prismicio/client": "^7.22.3",
    "@prismicio/custom-types-client": "^2.1.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "bin": {
    "smaltic": "./dist/cli.js"
  },
  "files": [
    "dist"
  ]
}
